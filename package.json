{
  "name": "zmem2",
  "version": "0.1.1",
  "description": "Local-first computed Git memory segments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "zmem": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:smoke": "npm run build && node --test dist/tests/cli-entrypoint.test.js dist/tests/background-cli.test.js",
    "test:release": "node --test scripts/release/*.test.mjs",
    "start": "node dist/src/cli/main.js",
    "prepack": "npm run build",
    "format": "prettier --write src tests scripts README.md docs skills package.json tsconfig.json .github",
    "format:check": "prettier --check src tests scripts README.md docs skills package.json tsconfig.json .github",
    "bench": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "es-module-lexer": "3.0.4",
    "lru-cache": "11.5.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
